rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Só entram as pessoas com estes e-mails (troque pelos e-mails da sua equipe)
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'fernando.gasperazzo@gmail.com'
        ];
    }
  }
}
